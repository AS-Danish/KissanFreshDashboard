KISSAN_ENV=debug
NEXT_PUBLIC_APP_ENV=debug

# Use a separate Firebase project. The debug launcher refuses the production ID.
NEXT_PUBLIC_FIREBASE_API_KEY=replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-debug-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-debug-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-debug-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
NEXT_PUBLIC_FIREBASE_APP_ID=replace_me

# Keep any optional search configuration separate from production too.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
