# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.debug.example
!functions/.env.debug.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
service-account.json
admin_app/

# Local reports produced by one-off Firebase migrations
/.migration-manifests/
/.generated/
/.firebase-secret-input
/.debug-test-credentials.json
